# Environment Configuration
NODE_ENV=development

# HH.ru OAuth (server-only)
# Use a separate approved HH app per contour (prod/dev) with identical settings.
# HH_ru_client_id=your_hh_client_id
# HH_ru_client_secret=your_hh_client_secret
# HH_RU_REDIRECT_URI=https://your-domain.com/api/integrations/hh/callback
# Optional: site host for HH API requests.
# HH_RU_HOST=hh.ru
# HH_USER_AGENT=MyApp/1.0 (my-app-feedback@example.com)

# Future: AI Provider Configuration
# AI_PROVIDER=openai|gemini|deepseek|anthropic
# OPENAI_API_KEY=sk-your-key-here
# GEMINI_API_KEY=your-key-here
# DEEPSEEK_API_KEY=your-key-here
# ANTHROPIC_API_KEY=your-key-here
#
# Optional model overrides:
# OPENAI_MODEL=gpt-5.2
# GEMINI_MODEL=gemini-2.5-flash
# DEEPSEEK_MODEL=deepseek-v4-flash

# DeepSeek candidate card prefill parser (web/API route, server-only)
# DEEPSEEK_CANDIDATE_PARSER_MODEL=deepseek-v4-flash
# DEEPSEEK_CANDIDATE_PARSER_MAX_TOKENS=3000
# DEEPSEEK_CANDIDATE_PARSER_TIMEOUT_MS=6000
# DEEPSEEK_CANDIDATE_PARSER_TOTAL_TIMEOUT_MS=12000
# DEEPSEEK_CANDIDATE_PARSER_CONCURRENCY_LIMIT=1000
# DEEPSEEK_CANDIDATE_PARSER_QUEUE_TIMEOUT_MS=3000

# Future: Supabase Configuration
# NEXT_PUBLIC_SUPABASE_URL=your-project-url.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# APP_ORIGIN=https://your-production-domain.com
# AUTH_VERIFICATION_CONTEXT_SECRET=long-random-secret
# Supabase Auth redirect URLs (Dashboard -> Authentication -> URL Configuration):
# - http://localhost:3000/auth/callback
# - https://your-production-domain.com/auth/callback

# Web app resume extraction via protected Tika proxy
TIKA_BASE_URL=https://your-tika-proxy.example.com
TIKA_AUTH_TOKEN=
# Keep this greater than the proxy TIKA_UPSTREAM_TIMEOUT_MS so the proxy can return classified timeout/unavailable responses.
TIKA_TIMEOUT_MS=20000

# Telegram bot (webhook-only)
# TELEGRAM_BOT_TOKEN=123456:ABCDEF...
# TELEGRAM_BOT_USERNAME=hiiire_bot
# TELEGRAM_WEBHOOK_SECRET=long-random-secret
# TELEGRAM_OWNER_CHAT_IDS=123456789,987654321
# Optional: choose either the relay or an HTTP(S) forward proxy for Telegram Bot API calls; do not set both
# TELEGRAM_RELAY_URL=https://tg.hiiire.com
# TELEGRAM_RELAY_SECRET=long-random-relay-secret
# TELEGRAM_PROXY_URL=http://user:password@proxy.example.com:8080
# TELEGRAM_REQUEST_TIMEOUT_MS=8000

# Email notifications (Resend, server-only)
# RESEND_API_KEY=re_...
# EMAIL_FROM=hiiire <noreply@yourdomain.com>
# EMAIL_OWNER_RECIPIENTS=owner1@yourdomain.com,owner2@yourdomain.com

# Cron protection (for /api/cron/* endpoints)
# CRON_SECRET=long-random-secret

# Legal operator requisites shown on /terms, /privacy, /refund, /contact, /about (server-only, read at runtime).
# Required in production; without them the legal pages render without requisites and the server logs an error.
# LEGAL_OPERATOR_NAME=Индивидуальный предприниматель Иванов Иван Иванович
# LEGAL_OPERATOR_INN=000000000000
# LEGAL_OPERATOR_OGRN=000000000000000
# LEGAL_OPERATOR_REGISTRATION_DATE=01.01.2025

# Robokassa billing
# ROBOKASSA_MERCHANT_LOGIN=your-merchant-login
# ROBOKASSA_PASSWORD1=your-password-1
# ROBOKASSA_PASSWORD2=your-password-2
# ROBOKASSA_IS_TEST=true
# ROBOKASSA_HASH_ALGORITHM=md5
# ROBOKASSA_PAYMENT_URL=https://auth.robokassa.ru/Merchant/Index.aspx
# ROBOKASSA_RECURRING_URL=https://auth.robokassa.ru/Merchant/Recurring
# ROBOKASSA_RECURRING_ENABLED=false

# PostHog analytics (optional, set on web and worker apps)
# NEXT_PUBLIC_POSTHOG_KEY=phc_your_project_key
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
