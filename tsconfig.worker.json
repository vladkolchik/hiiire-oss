{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "rewriteRelativeImportExtensions": true,
    "resolveJsonModule": true,
    "outDir": "worker/dist",
    "rootDir": "worker/src",
    "types": ["node"]
  },
  "include": ["worker/src/**/*.ts"],
  "exclude": ["node_modules"]
}

